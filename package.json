{
  "name": "iran-opportunity-ecosystem",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "qa:phase2": "python scripts/qa_phase2.py",
    "qa:phase3": "python scripts/qa_phase3.py",
    "qa:phase4": "python scripts/qa_phase4.py",
    "qa:phase5": "python scripts/qa_phase5.py",
    "test:content": "python -m unittest scripts/test_content_integrity.py -v",
    "qa:all": "pnpm test:content && pnpm qa:phase2 && pnpm qa:phase3 && pnpm qa:phase4 && pnpm qa:phase5",
    "ingest": "python scripts/content_pipeline.py ingest",
    "ingest:dry-run": "python scripts/content_pipeline.py dry-run",
    "content:validate": "python scripts/content_pipeline.py validate",
    "postcontent:validate": "pnpm content:validate:ts",
    "content:validate:ts": "tsc -p tsconfig.runtime.json && node .tmp/content-validation/validate.js",
    "content:validate:strict": "python scripts/content_pipeline.py validate --strict-translations",
    "content:diff": "python scripts/content_pipeline.py diff"
  },
  "dependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/topojson-client": "^3.1.5",
    "d3-geo": "^3.1.1",
    "echarts": "^6.1.0",
    "framer-motion": "^13.2.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/topojson-specification": "^1.0.5",
    "typescript": "^5.9.2"
  }
}
